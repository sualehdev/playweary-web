# Copy to .env.local for local dev. On Vercel set these in Project → Settings → Environment Variables.

# Public URL of the Playweary API (NestJS). Called from the browser (checkout, tracking)
# and from the server (catalog). Leave unset to run the site on its static fallback catalogue.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shared secret for POST /api/revalidate (must equal REVALIDATE_SECRET in the API).
# Server-only: never prefix with NEXT_PUBLIC_. Generate with: openssl rand -base64 48
REVALIDATE_SECRET=change-me

# Canonical site URL (sitemap, share cards)
# NEXT_PUBLIC_SITE_URL=https://playweary.com

# Christmas offer shown in the pop-up, banner and Santa button (no promo code).
# The Christmas offer text is fixed at "25% off" in src/christmas/config.ts.
# Set NEXT_PUBLIC_XMAS_OFFER=off only to hide the offer.

# Google Tag Manager container (GTM-XXXXXXX). Unset = no tracking (dev/preview).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
