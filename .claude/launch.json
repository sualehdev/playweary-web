{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../playweary-api",
        "run",
        "start:dev"
      ],
      "port": 4000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../playweary-admin",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
